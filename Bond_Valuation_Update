def bond_value(face_value, coupon_rate, frequency, maturity_years):
    coupon_amount = (coupon_rate/100 * face_value)/frequency
    coupon_periods = frequency * maturity_years
    scale = 1/frequency

    total_present_value_coupons = 0


    for x in range(coupon_periods):
        scale_counter = (x+1) * scale
        pv_coupon = coupon_amount * interp_discount_factor(scale_counter)
        total_present_value_coupons = total_present_value_coupons + pv_coupon

    present_value_principal = face_value * interp_discount_factor(maturity_years)
    bond_price = total_present_value_coupons + present_value_principal
    return bond_price
